# Copier vers .env.local et remplir les valeurs
# .env.local est gitignored

# ── Postgres (local Docker) ──────────────────────────────────────────────────
DATABASE_URI=postgres://lg:lg@localhost:5433/lg

# ── Payload ──────────────────────────────────────────────────────────────────
# Génère un secret avec : openssl rand -base64 32
PAYLOAD_SECRET=replace-with-random-string

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Better Auth ──────────────────────────────────────────────────────────────
# Génère un secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-random-string
BETTER_AUTH_URL=http://localhost:3000

# ── Resend (emails transactionnels) ──────────────────────────────────────────
# Sans ces vars, les emails sont loggués au terminal (dev local OK).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=hello@tondomaine.com

# ── Stripe (paiement) ────────────────────────────────────────────────────────
# Local : installe stripe-cli puis lance :
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Cette commande affiche le STRIPE_WEBHOOK_SECRET à utiliser ici.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# STRIPE_PRICE_ID_PREMIUM=price_xxxxxxxxxxxx

# ── Traduction IA (FR ↔ EN dans l'admin) ─────────────────────────────────────
# Au moins une des deux clés doit être présente pour activer le bouton "Traduire".
# Si les deux sont définies, Anthropic est préféré par défaut (TRANSLATE_PROVIDER=auto).
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
# TRANSLATE_PROVIDER=auto                   # auto | anthropic | openai
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini        # optionnel, défaut gpt-4o-mini
